{
  "name": "doomcon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A real-time index of AI activity tempo, computed from public data by open code. Five pillars, one 0-100 score, one level. Every number is recomputable.",
  "keywords": [
    "ai",
    "index",
    "open-data",
    "observability",
    "static-site"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://siren.watch",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/messagegabrielhere-lgtm/doomcon.git"
  },
  "bugs": {
    "url": "https://github.com/messagegabrielhere-lgtm/doomcon/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "backfill": "node collector/backfill.mjs",
    "collect": "node collector/collect.mjs",
    "score": "node collector/engine.mjs",
    "build": "node site/build.mjs",
    "build:news": "node site/build.mjs --only news",
    "pipeline": "npm run collect && npm run score && npm run build",
    "posts": "node collector/posts.mjs",
    "cards": "node collector/card.mjs",
    "engage": "node site/engage-sheet.mjs",
    "test:posts": "node collector/posts.mjs --test",
    "test:engage": "node collector/x-engage.mjs --selftest",
    "test:arena": "node --test arena/test.mjs",
    "test:fable": "node --test fable/test.mjs",
    "fable": "node fable/cli.mjs",
    "test:investors": "node --test investors/test.mjs",
    "test:backup": "node collector/tools/backup.mjs selftest",
    "test:launch": "node collector/tools/launch-smoke.mjs",
    "seo:daily": "node collector/tools/seo-daily.mjs",
    "test:seo-daily": "node collector/tools/seo-daily.mjs --selftest && node --test collector/test/seo-daily.test.mjs",
    "test:item-archive": "node --test collector/test/item-archive.test.mjs",
    "test:image-credit": "node collector/tools/image-credit.mjs selftest",
    "image-credit": "node collector/tools/image-credit.mjs",
    "test:safe-error": "node --test collector/test/safe-error.test.mjs",
    "test:agent-kit": "node --test agent-kit/test.mjs",
    "siren": "node agent-kit/cli.mjs",
    "siren-mcp": "node agent-kit/mcp.mjs",
    "backup": "node collector/tools/backup.mjs backup",
    "compliance": "node compliance/selftest.mjs && node compliance/audit.mjs --strict",
    "test:compliance": "node compliance/selftest.mjs",
    "compliance:fix": "node compliance/audit.mjs --fix --report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0"
  }
}
