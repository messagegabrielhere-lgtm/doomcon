# Required: your Anthropic API key (never ship this inside the iOS app).
ANTHROPIC_API_KEY=
# Public base URL of this server, used in executor emails.
PUBLIC_URL=http://localhost:8787
PORT=8787
# Where account data is stored (JSON files). Use encrypted storage in production.
DATA_DIR=./data
# Optional: send real email through Resend. Without it, emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=Evensong <legacy@example.com>
