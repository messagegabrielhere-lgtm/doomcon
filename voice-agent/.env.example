# Copy to voice-agent/.env, fill in, then run: node voice-agent/configure.mjs
# .env is gitignored. Values may contain spaces and apostrophes.

# --- Who the assistant works for ---------------------------------------------
AGENT_NAME=Sam Rivera
BROKERAGE=Harbor Realty
AGENT_PHONE=+15555550123          # E.164. Live transfers and the voicemail callback go here.
AGENT_EMAIL=sam@example.com       # Hot-lead alerts go here; also the default calendar.
SERVICE_AREA=Austin and the surrounding Hill Country
ASSISTANT_NAME=Jordan
TIMEZONE=America/Chicago          # IANA name: showing hours, calling hours, dates.

# --- n8n ----------------------------------------------------------------------
N8N_BASE_URL=https://your-n8n.example.com   # Public URL, no trailing slash.
VAPI_WEBHOOK_SECRET=change-me-to-a-long-random-string
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/XXXXXXXX/edit
# GOOGLE_CALENDAR_ID=sam@example.com  # Defaults to AGENT_EMAIL.

# --- Vapi ---------------------------------------------------------------------
VAPI_API_KEY=                     # Private key: dashboard.vapi.ai -> API Keys. Only used by configure.mjs.
VAPI_ASSISTANT_ID=                # Printed by: node voice-agent/configure.mjs --create-assistant
VAPI_PHONE_NUMBER_ID=             # The number the assistant calls from / answers on.

# --- Optional (defaults shown) ------------------------------------------------
# CALL_WINDOW_START=9             # Outbound calls only between these local hours.
# CALL_WINDOW_END=20
# SHOWING_START_HOUR=10
# SHOWING_END_HOUR=18
# SHOWING_MINUTES=30
# HOT_LEAD_SCORE=7                # Leads scoring this or above get emailed to the agent.
# DEFAULT_COUNTRY_CODE=1          # For numbers typed without a +country code.
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# VOICE_PROVIDER=vapi
# VOICE_ID=Elliot
