# Copy to .env and fill in. .env is gitignored and never committed.
# In production these live in GitHub -> Settings -> Secrets and variables -> Actions.

# X / Twitter — OAuth 1.0a, needs Read+Write app permissions
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Safety switch. Anything other than "live" writes posts to disk instead of publishing.
POST_MODE=dry-run

# Compliance: comma-separated private strings that must never appear in the
# public repo (real name, personal email, phone). Used only by
# compliance/audit.mjs via the COMPLIANCE_PII_TERMS GitHub Actions secret —
# do not commit real values here.
# COMPLIANCE_PII_TERMS=
