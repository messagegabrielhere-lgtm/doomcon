# Copy to .env and fill in. .env is gitignored and never committed.
# In production these live in GitHub -> Settings -> Secrets and variables -> Actions.
# Full inventory (every workflow secret/variable): docs/GITHUB.md
# Reporting / rotation policy: SECURITY.md

# X / Twitter — OAuth 1.0a, needs Read+Write app permissions
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Bluesky (optional; post-daily no-ops this path when unset)
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# Safety switch. Anything other than "live" writes posts to disk instead of publishing.
POST_MODE=dry-run

# Optional model keys for arena/ (each missing key → labelled stand-in)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=

# Optional compliance tripwire (comma-separated private strings that must never appear in git)
# COMPLIANCE_PII_TERMS=
