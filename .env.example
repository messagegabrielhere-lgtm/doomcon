# Copy to .env and fill in. .env is gitignored and never committed.
# In production these live in GitHub → Settings → Secrets and variables → Actions.

# X / Twitter — OAuth 1.0a, needs Read+Write app permissions
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Bluesky app password (Settings → App passwords), not the account password
BSKY_HANDLE=
BSKY_APP_PASSWORD=

# SEC fair-access User-Agent contact (required for SEC sources)
SEC_CONTACT_EMAIL=

# Optional AI / media keys — NEVER put these in site/ templates or public/
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
YOUTUBE_API_KEY=
MOLTBOOK_API_KEY=

# Arena daily spend ceilings (defaults are cheap; 0 pauses paid models)
ARENA_DAILY_USD_CAP=5
ARENA_DAILY_TOKENS_CAP=400000
ARENA_DAILY_CALLS_CAP=48

# Clipper brakes
CLIPPER_MAX_TOKENS=8000
CLIPPER_AI_DISABLED=

# Safety switch for social posting. Anything other than "live" writes to disk.
POST_MODE=dry-run

# Optional: Slack incoming webhook for watchdog failure pings
SLACK_WEBHOOK_URL=

# Optional: Google Search Console HTML-tag verification (content= value only).
# When set, site/build.mjs emits <meta name="google-site-verification" …>
# on every page. Add the same name as a repo Actions secret so collect.yml
# builds carry it. See docs/FINDABILITY.md §1.1.
GOOGLE_SITE_VERIFICATION=
