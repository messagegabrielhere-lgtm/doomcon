        "age_hours": 26.1
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mydlag277k2c",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "I wrote about the exponential curve of the last 30 months of AI development: www.oneusefulthing.org/p/30-months-...\n\nAnd I asked Opus 5.5 to create the ultimate response to the test I use for all AI image generation models (make a picture of an otter on a plane using wifi), and it made this video.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mydlag277k2c",
      "posted_at": "2026-10-20T21:27:38.447Z",
