    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3n2762wfcot2x",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "The smaller scandal is that the White House has been perfectly happy to use export control laws against US AI companies like Anthropic while knowingly letting Nvidia get away with activities that arguably damaged national security.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3n2762wfcot2x",
      "posted_at": "2026-11-13T14:11:39.522Z",
      "likes": 14,
      "replies": 0,
      "reposts": 3,
      "score": 5.3,
      "score_parts": {
        "engagement": 1.3,
        "recency": 0.9,
        "age_hours": 13.7
      }
    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3n2762wfcos2x",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "The larger issue is that Nvidia was selling to Megaspeed in Singapore, which is known to be smuggling chips to China. The White House and Trump knew about it and were not enforcing export controls while simultaneously talking about  the AI arms race against China.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3n2762wfcos2x",
