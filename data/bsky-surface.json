    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mywnjrmkb22z",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "Artificial Analysis finally moves to closed benchmarks (goodbye & good riddance, GDPval-AA), and finds that open weights models are falling  further behind than they had previously measured. Take with a grain of salt, but matches the general vibes that we haven't seen a Fable-class open model.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mywnjrmkb22z",
      "posted_at": "2026-10-28T11:29:15.081Z",
      "likes": 165,
      "replies": 18,
      "reposts": 15,
      "score": 7.1,
      "score_parts": {
        "engagement": 2.3,
        "recency": 0.8,
        "age_hours": 30.9
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3myvqffe2d22q",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "Google's Genie 4 world model: \"Scene: A Victorian high tea. Character: A mouse in appropriate garb.\"\n\n\"A porcupine walks by\"\n\n\"The mouse grows wings\"\n\n\"It flies\"\n\nThis is realtime & I can walk around freely.\n\nIt is glitchy, but also impossibly advanced compared to where we were a couple years ago.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3myvqffe2d22q",
      "posted_at": "2026-10-28T02:47:49.493Z",
      "likes": 105,
