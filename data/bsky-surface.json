        "recency": 0.7,
        "age_hours": 55.3
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mxq4bhezas2q",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "GPT-4 was the undisputed best model in the world for a full year and we all debated whether anyone could catch up or if OpenAI had some secret formula that nobody else knew about.\n\nNow there are are 19 AI models that can run on a modern smartphone that are better than GPT-4!",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mxq4bhezas2q",
      "posted_at": "2026-10-13T03:39:12.245Z",
      "likes": 203,
      "replies": 7,
      "reposts": 30,
      "score": 6.5,
