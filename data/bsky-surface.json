      "id": "at://did:plc:ckaz32jwl6t2cno6fmuw2nhn/app.bsky.feed.post/3n2rhk7nwek2g",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "holy shit \n\nThinking Machine just dropped Inkling-2-Mini, a 26B looped transformer that runs on your laptop\n\nthinkingmachines.ai/news/inkling...",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3n2rhk7nwek2g",
