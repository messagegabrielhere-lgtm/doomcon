    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n2n3vjt7622m",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "At its current shipping trend, halving the time between each model release, Google exhausts all the element names on November 24, with a final shipping cadence of 2.5 × 10⁻²⁹ seconds (25 quectoseconds) between Tennessine and their final model, Oganesson.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3n2n3vjt7622m",
      "posted_at": "2026-11-19T03:10:07.824Z",
      "likes": 165,
      "replies": 13,
      "reposts": 10,
      "score": 7.2,
      "score_parts": {
        "engagement": 2.3,
        "recency": 0.9,
        "age_hours": 22.5
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n2khd3gsqc2z",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "That isn't patches because of AI mistakes, by the way, it is patches because AI is discovering security vulnerabilities at an unheard of rate, and if they aren't patched, they may be exploited.",
