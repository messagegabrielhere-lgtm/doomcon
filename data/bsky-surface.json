      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n2cotuxdvk22",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "AI is getting better faster than our measurements are.\n\nI threw together SatBench, which measures how quickly major AI benchmarks become saturated (effectively solved) by AI. Of 173 benchmarks cited by the Labs since 2023, 63% are now saturated. Saturation of new benchmarks is also happening faster.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3n2cotuxdvk22",
      "posted_at": "2026-11-14T23:49:56.358Z",
      "likes": 110,
      "replies": 9,
      "reposts": 13,
      "score": 7,
