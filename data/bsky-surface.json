    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3myppj3u7xk26",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "The website for my book redone with Opus 5.5. The initial version (made with Opus 4.8) required a lot of work to make a distinctive-looking static site. Now Opus mostly did this alone. We have come a long way from generic ClaudeDesign in a very short time. co-existence.ai",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3myppj3u7xk26",
      "posted_at": "2026-10-25T17:16:01.581Z",
      "likes": 63,
