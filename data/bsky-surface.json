        "recency": 0.8,
        "age_hours": 29.3
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n27sqcs6ds22",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "\"You see the model called hydrogen is equivalent to the models called sonnet and luna and spark, but the model called fable is like wonder and astra and carbon (but it was like argon)\"\n\n\"Wait, why do you look confused?\"",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3n27sqcs6ds22",
