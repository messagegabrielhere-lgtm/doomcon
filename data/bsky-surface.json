    },
    {
      "id": "at://did:plc:bdb6mpkg3hpmaye3mtp4w56m/app.bsky.feed.post/3mzuh2xga2223",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "I guess the new Chinese models did pose a national security threat",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzuh2xga2223",
      "posted_at": "2026-11-09T07:53:27.553Z",
      "likes": 2584,
