    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n2req7quy225",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "The effective end of easy distillation from OpenAI and Anthropic models may be behind the relative slowdown in open weights model progress. We don’t know the extent to which distillation has been key to the rapid improvement in open weights, I guess we will find out soon. openai.com/index/combat...",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3n2req7quy225",
      "posted_at": "2026-11-20T19:58:52.119Z",
