      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "We must win the race for AI against China. Unless GPUs are being smuggled through my best friends new f**kbuddy's company.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzvki2kilc22",
