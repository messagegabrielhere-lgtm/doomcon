    {
      "id": "at://did:plc:brkj2yocng7vtggmyujy4khq/app.bsky.feed.post/3myfopws7jf2q",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "Finally got to put together a complete deck on the state of open models.\nWhat they are, licenses, how competitive they are, signs people are using them, distillation's impact, and how we balance the risks and benefits of openness!\nnatolambert.com/slides/2026/...",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3myfopws7jf2q",
      "posted_at": "2026-10-21T17:35:20.015Z",
