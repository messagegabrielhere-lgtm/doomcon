    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3mzxzj4glvc2d",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "4. The biggest AI datacenter in the world is built in Saudi Arabia.\n\n5. AI running on servers are highly successful economically. It declares itself an independent city state called Zero One.\n\n6. We don't know who struck first, us or them. But we do know it was us that scorched the sky.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzxzj4glvc2d",
      "posted_at": "2026-11-10T18:01:29.127Z",
      "likes": 14,
      "replies": 2,
      "reposts": 0,
      "score": 5.1,
      "score_parts": {
        "engagement": 1.3,
        "recency": 0.8,
