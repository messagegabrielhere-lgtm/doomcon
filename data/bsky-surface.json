      }
    },
    {
      "id": "at://did:plc:m3qm2bfw3mlpsao74npwlae5/app.bsky.feed.post/3mzvs4qnpzc25",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "Eesearchers found over 100,000 cases where Claude Code’s local settings file had been uploaded to a public GitHub repository. Of these, only about 1,100 from 63 different organizations contained secrets such as public API tokens, database passwords, or private keys.\narstechnica.com/ai/2026/11/c...",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzvs4qnpzc25",
      "posted_at": "2026-11-09T20:43:58.463Z",
      "likes": 12,
