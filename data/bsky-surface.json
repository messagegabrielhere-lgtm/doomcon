      }
    },
    {
      "id": "at://did:plc:rrjvo5jwuateqep2i7ih5ckl/app.bsky.feed.post/3mxwf4huoqs2n",
      "handle": "cfiesler.bsky.social",
      "display_name": "Casey Fiesler",
      "text": "This is a panel for open access week about scholarly communication. \n\nI have no idea what models ACM is using - if they're not using the \"newest\" and \"best\" that probably just makes it worse.",
