        "recency": 0.5,
        "age_hours": 89.4
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mz7swluwac2w",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "The Pro series of GPT models continues to be really impressive for one-shot problems that involve complex calculations, references, or sophisticated ideas.\n\nIt isn't particularly fast (or particularly pleasant) to use but GPT-6 Astra Pro gives that \"ask one question of the great oracle\" feel.",
