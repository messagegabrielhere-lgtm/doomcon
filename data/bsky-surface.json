        "recency": 0.4,
        "age_hours": 103.6
      }
    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3mzazktiytc2v",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "“Service Model” by Adrian Tchaikovsky is an interesting recent contribution to this genre of dystopia.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzazktiytc2v",
      "posted_at": "2026-11-01T14:31:12.906Z",
      "likes": 3,
      "replies": 1,
      "reposts": 0,
      "score": 4.5,
      "score_parts": {
