    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3n2jfjfcgr22t",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "okay, back at it. The most successful weight editing technique for creating a persona so far is to have Astra implement a FSM inside weight space that adds self-instructions before responding to the prompt. \n\nThe <thinking> tokens below are generated by the FSM portion of the model weights.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3n2jfjfcgr22t",
      "posted_at": "2026-11-17T15:51:38.890Z",
