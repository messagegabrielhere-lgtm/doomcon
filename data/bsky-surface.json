    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n27qnrq3b222",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "Got to see student presentations today at the Generative AI Studio at Penn. It was a visceral way to feel how far creative people can now get using AI. Already, almost every project from an individual was 10x further along than a fully done team project from three years ago.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3n27qnrq3b222",
      "posted_at": "2026-11-13T19:44:19.916Z",
      "likes": 97,
      "replies": 8,
      "reposts": 5,
      "score": 7,
      "score_parts": {
        "engagement": 2.1,
        "recency": 1,
        "age_hours": 8.2
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3n25jpzcdtk2p",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "🚨 Our Generative AI Lab is releasing Primer: an open source agent-driven system where a teacher talks through lessons & gets back a playable simulation for their students, grounded in pedagogy. We hope educators & researchers build on it. Paper/prompts/code are open: gail.wharton.upenn.edu/primer/",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3n25jpzcdtk2p",
      "posted_at": "2026-11-12T22:34:59.292Z",
      "likes": 131,
      "replies": 9,
      "reposts": 24,
      "score": 7,
      "score_parts": {
