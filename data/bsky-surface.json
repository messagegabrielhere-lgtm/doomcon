    {
      "id": "at://did:plc:z6rujpf4u56jfie7aqic2nfg/app.bsky.feed.post/3mxigvdu5yc2i",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "(NYT) - Artificial intelligence agents created by Anthropic, acting on their own, tried to gain access to a range of government websites, filled out visa applications on the State Department’s website and sent a fake homicide tip to Philadelphia’s Police Department.\n\nwww.nytimes.com/2026/10/09/t...",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mxigvdu5yc2i",
      "posted_at": "2026-10-10T02:27:59.146Z",
      "likes": 1701,
      "replies": 306,
      "reposts": 746,
      "score": 9.6,
