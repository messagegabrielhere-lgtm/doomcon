      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mxnnvoyesk2a",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "GPT-6 Pro finds supposed errors in academic papers all the time, just as part of other work. Confirming the errors aren't nitpicks & learning their importance would still take a lot of time today, but it will get faster. We don't have the right mechanisms in place to deal a flood of corrections.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mxnnvoyesk2a",
