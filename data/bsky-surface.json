        "recency": 0.3,
        "age_hours": 124.1
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mywnjrmkb22z",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "Artificial Analysis finally moves to closed benchmarks (goodbye & good riddance, GDPval-AA), and finds that open weights models are falling  further behind than they had previously measured. Take with a grain of salt, but matches the general vibes that we haven't seen a Fable-class open model.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mywnjrmkb22z",
      "posted_at": "2026-10-28T11:29:15.081Z",
      "likes": 172,
      "replies": 18,
      "reposts": 15,
      "score": 5.9,
      "score_parts": {
