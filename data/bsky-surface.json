    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mysy6zyphs25",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "Two and a half years between these.\n\n(Tonight, OpenAI announced an unreleased model solved three long-standing problems in physics, math, and computer science, one of which was proving the Exponential Time Hypothesis was false)",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mysy6zyphs25",
      "posted_at": "2026-10-27T00:29:26.974Z",
      "likes": 136,
