    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3myd4idyjkk2c",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "My new book, Co-Existence, is out today. It is a guide to how to live and work in a world where AI is sometimes, but not always, better than you.\n\n(And, for the release, I worked with Opus 5.5 to make a quite interesting experience for the book's new website: co-existence.ai)",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3myd4idyjkk2c",
      "posted_at": "2026-10-20T17:03:38.598Z",
      "likes": 107,
      "replies": 7,
      "reposts": 10,
      "score": 6.4,
      "score_parts": {
        "engagement": 2.1,
        "recency": 0.7,
        "age_hours": 48.6
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3myffkbheuc2e",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "Companies I talk to are struggling with the rate of patches they need to do thanks to AI defenses finding issues before the coming wave of incoming cyberattacks by other AIs.\n\nNow consumers are going to have the same experience of getting everything updated often & fast. openai.com/index/coordi...",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3myffkbheuc2e",
      "posted_at": "2026-10-21T14:51:06.205Z",
      "likes": 61,
