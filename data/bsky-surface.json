    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3myuvyco2fs2z",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "The argument that AI labs are talking about existential risks as a way of creating hype & inflating their stock prices has always been odd.\n\nYou don't need to believe them, but telling people your product may murder everyone does not, in fact, encourage people to adopt it or reduce regulatory risks.",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3myuvyco2fs2z",
      "posted_at": "2026-10-27T18:55:13.179Z",
      "likes": 94,
      "replies": 11,
      "reposts": 7,
