      }
    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3n2pd2ci4zs2r",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "Anthropic employee who suddenly became very wealthy today and could probably retire comfortably this very instant says that AI will make people permanently unemployable \n\nfuturism.com/future-socie...",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3n2pd2ci4zs2r",
      "posted_at": "2026-11-20T00:23:23.563Z",
      "likes": 6,
      "replies": 0,
      "reposts": 0,
      "score": 4.6,
      "score_parts": {
        "engagement": 0.8,
        "recency": 1,
        "age_hours": 3.2
      }
    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3n2pmyev7hk2r",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "Please consult academic AI researchers to get the real story from people who are not financially invested in one outcome or another (hype or doom). You don’t have to listen to me. You have great universities in your state. Listen to your public universities. They are there to serve, not sell.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3n2pmyev7hk2r",
      "posted_at": "2026-11-20T03:21:16.398Z",
      "likes": 2,
      "replies": 0,
      "reposts": 0,
      "score": 3.9,
