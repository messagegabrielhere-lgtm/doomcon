        "recency": 0.9,
        "age_hours": 10.6
      }
    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3mzdwq2vpas25",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "AI should benefit everyone. So we built a benchmark.\n\nThat’s not how benchmarks work. \n\nThat’s just Goodhart’s law as a service.",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzdwq2vpas25",
      "posted_at": "2026-11-02T18:18:26.422Z",
      "likes": 19,
