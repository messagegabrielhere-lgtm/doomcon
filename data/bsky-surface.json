        "recency": 1,
        "age_hours": 5.4
      }
    },
    {
      "id": "at://did:plc:3igkkqe5nkm66olc4y2syzpy/app.bsky.feed.post/3mzewrd7r4k2e",
      "handle": "markriedl.bsky.social",
      "display_name": "Mark Riedl",
      "text": "AI Agents are amazing! Because AI Agents are so good at doing things I have, to date:\n\n- Learned to play guitar\n- Taught myself how to do 3D CAD modeling completely by hand\n\nAm I doing this right?",
      "url": "https://bsky.app/profile/markriedl.bsky.social/post/3mzewrd7r4k2e",
      "posted_at": "2026-11-03T03:51:48.435Z",
      "likes": 6,
      "replies": 2,
      "reposts": 0,
      "score": 5,
      "score_parts": {
