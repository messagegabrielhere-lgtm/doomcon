        "recency": 0.8,
        "age_hours": 25.8
      }
    },
    {
      "id": "at://did:plc:flxq4uyjfotciovpw3x3fxnu/app.bsky.feed.post/3mxr77gpvik2q",
      "handle": "emollick.bsky.social",
      "display_name": "Ethan Mollick",
      "text": "A worthwhile (and unnerving) reminder from Anthropic that we should be paying attention to AI ability thresholds, not just steady climbs\n\nIn this case, the threshold is the capability needed for a self-replicating AI worm on IoT devices like off-brand TVs www.anthropic.com/research/sel...",
      "url": "https://bsky.app/profile/emollick.bsky.social/post/3mxr77gpvik2q",
      "posted_at": "2026-10-13T14:04:25.408Z",
      "likes": 61,
