# Picking the clips (the "viral moment" detector)
ANTHROPIC_API_KEY=

# YouTube Shorts: an OAuth client from Google Cloud console (Desktop app type),
# with the YouTube Data API v3 enabled. Get the refresh token with:
#   node src/cli.mjs auth youtube
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# TikTok: an app on developers.tiktok.com with the Content Posting API and the
# video.publish scope. Until TikTok audits the app, posts can only be SELF_ONLY.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=

# Instagram Reels: a professional (business/creator) account and a long-lived
# token with instagram_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
